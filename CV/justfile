set shell := ["bash", "-euo", "pipefail", "-c"]

# Build the CV into build/.
default: build

build:
    latexmk -pdf -outdir=build -interaction=nonstopmode -halt-on-error mahyar-riazati-cv.tex

# Build and validate the PDF without network access.
check: build
    python3 scripts/check_cv.py

# Also verify public project repositories through gh.
check-links: check
    python3 scripts/check_cv.py --links

# Produce the assets consumed by the release workflow.
release-assets: check
    cd build && sha256sum mahyar-riazati-cv.pdf > SHA256SUMS

# Remove intermediate files while retaining the built PDF.
clean:
    latexmk -c -outdir=build mahyar-riazati-cv.tex
